# 애플리케이션 로그 — compose가 ../../logs 를 컨테이너 /logs 로 bind mount 한다
logs/

# p6spy 기본 출력 (spy.properties가 SLF4J로 돌리므로 정상 동작 시 생기지 않는다)
spy.log

# compose 배포 설정 — 정수장마다 다르므로 커밋하지 않는다 (.env.example만 추적)
.env

# 로컬 개인 설정 (Claude Code·MCP) — 접속정보가 들어갈 수 있다
.claude/settings.local.json
.mcp.json

# OS
.DS_Store
Thumbs.db

# 기타
*.stackdump


*.iml

# Python (ai/ai-service) — 로컬 실행 시 생성된다. 컨테이너 빌드는 COPY 목록이 정해져 있어
# 영향이 없지만, 커밋되면 다른 개발자의 인터프리터 버전과 어긋난 캐시가 섞인다.
__pycache__/
*.py[cod]
.venv/
