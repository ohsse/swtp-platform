# 정수장별 배포 설정 — 이 파일을 .env로 복사해 해당 정수장 값으로 맞춘다.
# docker compose는 compose.yaml이 있는 디렉토리의 .env를 자동으로 읽는다.
#
# SWTP_PROFILES: Spring 프로파일 활성 목록 (config-repo/application-<프로파일>.yml 선택).
#   컨테이너 배포는 환경 축 docker 하나다. 지정하지 않아도 compose 기본값 docker가 적용된다.
SWTP_PROFILES=docker
#
# SWTP_LOG_FORMAT: 콘솔(stdout) 로그 포맷. 지정하지 않으면 plain이다.
#   plain : 사람이 읽는 평문. 로그 수집 파이프라인을 운용하지 않는 정수장
#   ecs   : ECS(Elastic Common Schema) JSON 1줄. 수집기가 log.level/service.name/requestId를
#           필드로 색인한다 — 수집 파이프라인을 운용한다면 ecs로 둔다.
#           ELK(--profile elk)를 운용한다면 반드시 ecs로 둔다 — plain이면 수집은 되되
#           Kibana에서 필드 검색이 성립하지 않고 message 한 덩어리로만 보인다.
# 파일 로그(logs/<서비스>/)는 어느 값이든 평문이다 — 감사·장애분석용 백업이다.
SWTP_LOG_FORMAT=plain
#
# SWTP_SITE_CODE: 정수장 식별자. ECS 로그의 service.node.name과 모든 메트릭 문서에 실린다.
#   ★ 정수장 배포 시 반드시 채운다. 비워 두면 로그는 정상 적재되지만 사이트 식별자가 없고,
#     나중에 중앙 집계로 전환할 때 이미 적재된 인덱스를 재색인해야 한다.
#     인프라 배치는 되돌리기 쉽지만 데이터 스키마는 그렇지 않다.
#   형식: 대문자 영숫자 + 하이픈. 공백·한글 금지 (Kibana 필터에 그대로 쓰인다)
#   예시: GANGNEUNG-01
SWTP_SITE_CODE=
#
# ── 관측 백엔드 (ELK) ────────────────────────────────────────
# 기동: docker compose -f infrastructure/docker/compose.yaml --profile elk up -d
# elk는 앱 프로파일(auth/autonomous/pms/ai/full)과 다른 축이라 full에 포함되지 않는다.
#
# SWTP_ELASTIC_HOSTS: Beats가 색인을 보내는 주소.
#   정수장 서버 동거(기본)  : http://elasticsearch:9200  ← --profile elk로 함께 띄운다
#   중앙 집계로 전환         : http://<중앙주소>:9200     ← elk 프로파일을 켜지 않는다
#   전환 비용은 이 한 줄 + 프로파일 토글이다. 코드 변경은 없다.
SWTP_ELASTIC_HOSTS=http://elasticsearch:9200
#
# SWTP_ES_HEAP: Elasticsearch 힙. 단일 서버에 앱 11종 + Kafka + TimescaleDB가 이미 있으므로
#   자동 산정(가용 메모리의 절반)에 맡기지 않고 명시한다. 16GB 서버 기준 1g가 출발점이다.
SWTP_ES_HEAP=-Xms1g -Xmx1g
#
# SWTP_KIBANA_PUBLIC_URL: 운영자가 브라우저로 접속하는 주소 (Kibana가 자기 링크를 만들 때 쓴다)
SWTP_KIBANA_PUBLIC_URL=http://localhost:5601
#
# ── 인증 ─────────────────────────────────────────────────────
# SWTP_AUTH_MODE: 토큰 검증 모드. 지정하지 않으면 none이다.
#   none     : 검증하지 않는다(기본). 인증·인가를 앞단 포털/SSO가 처리하고 끝내는 정수장 —
#              기 구축 지자체가 이 형태다. swtp-platform은 사용자를 식별하지 않는다.
#   internal : 자체 auth-service가 발급한 토큰을 검증한다.
#   ★ none은 "모든 업무 API가 인증 없이 열린다"는 뜻이다. 앞단에서 막아 주는 관문이
#     실제로 있는 망에서만 쓴다. 이 모드에서는 감사 컬럼(rgstr_id/mdf_id)이 전부
#     시스템 기본값으로 기록되어 "누가 바꿨는가"가 남지 않고, 게이트웨이가 X-User-*
#     헤더를 지우므로 앞단이 사용자 정보를 헤더로 실어도 서비스까지 오지 않는다.
#   기동 로그에 경고 배너(############)가 찍히는지로 실제 적용된 모드를 확인한다.
SWTP_AUTH_MODE=none
#
# SWTP_AUTH_JWKS_URI: 공개키(JWKS) 위치. mode=internal일 때만 쓰인다.
#   비워 두면 compose가 게이트웨이 경유 주소를 넣는다 —
#     http://gateway:8080/auth-service/api/auth/.well-known/jwks.json
#   앞의 /auth-service 는 게이트웨이 라우트 접두사다(경로 규약 /{서비스명}/**).
#   auth-service를 직접 가리키지 않는 이유: micro 프로파일이 server.port=0을 주므로
#   컨테이너 안 실제 포트가 매 기동 달라진다. 게이트웨이가 Eureka로 찾아 넘겨준다.
#   즉 `--profile auth`로 auth-service를 함께 띄우는 구성이라면 위 SWTP_AUTH_MODE 한 줄이면 된다.
#   발급처가 그 밖에 있을 때만 여기에 주소를 적는다. mode와 한 쌍으로만 의미가 있으므로,
#   internal로 켜면서 닿지 않는 주소를 남겨 두지 않는다 — 게이트웨이는 그 상태로 기동하고
#   모든 요청이 503으로 떨어진다(JWKS 조회 실패는 401이 아니라 503이다).
SWTP_AUTH_JWKS_URI=
