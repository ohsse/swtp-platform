# 개행 정규화 — 기본은 Git 자동 판별
* text=auto

# 컨테이너에 마운트되어 리눅스에서 실행/파싱되는 파일은 Windows 체크아웃에서도 LF를 유지해야 한다.
# (CRLF로 체크아웃되면 shebang이 깨져 `#!/bin/bash^M: bad interpreter`로 기동에 실패한다)
*.sh            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
gradlew         text eol=lf

# Windows 전용 스크립트는 CRLF 고정
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 바이너리 — diff/개행 변환 금지
*.jar           binary
*.gz            binary
*.png           binary
*.damx          binary
*.db            binary
*.docx          binary
